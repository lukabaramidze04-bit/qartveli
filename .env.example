# Copy to .env for local development and fill in your own values.
# Never commit .env or paste your Discord bot token into chat.
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Optional Discord channel and role IDs
WELCOME_CHANNEL_ID=
LOG_CHANNEL_ID=
TICKET_PANEL_CHANNEL_ID=
TICKET_CATEGORY_ID=
STAFF_ROLE_ID=
TICKET_SUPPORT_ROLE_ID=
SUGGESTION_CHANNEL_ID=
REPORT_CHANNEL_ID=
ANNOUNCEMENT_CHANNEL_ID=
RANKS_CHANNEL_ID=
AUTO_ROLE_ID=
TICKET_CATEGORY_NAME=Tickets

# Optional AI integration. Keep the real key only in the host's private Variables.
# /ai prompts go to Groq; never put Discord tokens or secrets here.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
